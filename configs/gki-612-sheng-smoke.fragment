# 使用内存初始化环境隔离原有启动服务
CONFIG_CMDLINE_FORCE=y
CONFIG_INITRAMFS_FORCE=y
CONFIG_CMDLINE="rdinit=/init console=ttyGS0 earlycon keep_bootcon ignore_loglevel panic=10 regulator_ignore_unused clk_ignore_unused pd_ignore_unused"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# 将启动与 USB 日志所需依赖编入内核
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_8550=y
CONFIG_SM_TCSRCC_8550=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_SCM=y
CONFIG_PINCTRL_SM8550=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8550=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_LLCC=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_GADGET=y
# CONFIG_USB_DWC3_HOST is not set
# CONFIG_USB_DWC3_DUAL_ROLE is not set
CONFIG_PHY_QCOM_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# 首轮关闭存储、图形及远端处理器
# CONFIG_SCSI_UFS_QCOM is not set
# CONFIG_DRM_MSM is not set
# CONFIG_QCOM_Q6V5_PAS is not set
# CONFIG_QCOM_Q6V5_MSS is not set
CONFIG_LOCALVERSION="-android16-6-sheng-ram-smoke"
